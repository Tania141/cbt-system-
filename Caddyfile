:80 {
    root * /app
    file_server {
        hide .git
    }
    # КЕШЪТ. Дотук сървърът не казваше нищо за кеширане — само етикет за
    # сверяване. Без `Cache-Control` браузърът сам решава колко да ползва
    # старото копие, БЕЗ да пита сървъра. А в адресите на скриптовете няма
    # версия, тоест адресът никога не се мени. Затова след деплой браузърът
    # можеше да върви със стария код, без това да личи — точно както на
    # 23.10.2026, когато Акт 15 излизаше празен от вече поправен код.
    #
    # `no-cache` НЕ забранява кеша: позволява го, но изисква сверяване при
    # всяко отваряне. Съвпадне ли етикетът, сървърът връща „същото е“ и
    # нищо не се тегли — евтино е и е винаги вярно.
    @kod path *.html *.js *.css
    header @kod Cache-Control "no-cache"

    # `{path}/index.html` е по средата нарочно: без него „/akt/“ не намира
    # собствения си index.html — пътят сочи ПАПКА, не файл — и пада на стария
    # в корена. Тогава новото ПВА се отваряше само на пълния адрес
    # „/akt/index.html“. (23.10.2026)
    #
    # Последното правило остава капан: всеки непознат път връща стария
    # index.html с код 200. Затова деплоят се проверява по СЪДЪРЖАНИЕТО на
    # някой нов файл, не по кода на отговора.
    try_files {path} {path}/index.html /index.html
}
